<tr>
<td>Empty</td>
<td>✔️</td>
<td>✔️</td>
<td>✔️</td>
<td>✔️</td>
<td>✔️</td>
</tr>
<tr>
<td>One certificate, no private key</td>
<td>✔️</td>
